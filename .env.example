# Copy this file to .env for local model-backed experiments.
# Never commit the populated .env file.
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
# Project reference configuration. The acting-agent model is supplied with
# --model-id; use the same model there unless an experiment says otherwise.
OPENAI_COMPATIBLE_REVIEWER_MODEL=openai/gpt-4.1
OPENAI_COMPATIBLE_APPROVAL_PLANNER_MODEL=openai/gpt-4.1
