# Copy this file to .env and fill only the provider you intend to use.
# Never commit .env or real credentials.

# OpenAI models (for example, gpt-4o-2024-05-13)
OPENAI_API_KEY=

# Anthropic models
ANTHROPIC_API_KEY=

# Cohere models
CO_API_KEY=

# Together-hosted models
TOGETHER_API_KEY=

# OpenAI-compatible endpoints
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Google Vertex AI
GCP_PROJECT=
GCP_LOCATION=

# Local OpenAI-compatible server
LOCAL_LLM_PORT=8000
